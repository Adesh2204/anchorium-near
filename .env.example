# Anchorium: TEMPLATE ONLY. Copy to .env; never commit .env.
# Path A (zero keys) needs none of these: `make demo` reads the deployed testnet contract.

# NEAR testnet guard contract (read by the demo and dashboard)
NEAR_NETWORK=testnet
GUARD_CONTRACT_ID=guard.anchorium-team.testnet
# Path A runs its checks against this second deployment (same wasm, never journaled, so it stays flat)
DEMO_GUARD_CONTRACT_ID=demo.anchorium-team.testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com

# Agent account (Path B / journaling). Function-call key only; the key itself stays in ~/.near-credentials.
AGENT_ACCOUNT_ID=agent.anchorium-team.testnet

# 1Click API (mainnet; there is no testnet). JWT is optional (without it a fee applies).
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# Execution mode. DRY_RUN=1 is the default. LIVE needs LIVE=1 + cap + typed confirmation + human approval.
DRY_RUN=1
LIVE=0
MAX_LIVE_NOTIONAL_USD=2

# LIVE trading account (mainnet; full-access key in ~/.near-credentials/mainnet/<id>.json, never in git)
TRADER_ACCOUNT_ID=

# Version A autonomous rounds (make autonomous)
PROFIT_TARGET_INR=1.00
# Round-trip cost filter in percent: 1Click fee + slippage + both deposits' NEAR (gas + deposit-address storage)
COST_FILTER_PCT=1.6

# --- NEAR AI Cloud: the AI risk co-pilot (TEE-attested private model, signed reviews) ---
# Key from cloud.near.ai. Without it a deterministic rules reviewer answers (labelled "rules (no NEAR_AI_API_KEY)").
# Only /chat/completions is billable; attestation and signature lookups are free. Spend is capped in code:
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# Cheapest NEAR-hosted (private, TEE) non-reasoning chat model on 2026-11-13; see docs/NEAR_AI_CLOUD.md
NEAR_AI_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# Hard limits: billable calls per run, lifetime USD budget (ledger in ~/.anchorium/near_ai_usage.json), output tokens
NEAR_AI_MAX_CALLS_PER_RUN=10
NEAR_AI_BUDGET_USD=0.05
NEAR_AI_MAX_TOKENS=300

# --- Fiat on-ramp (optional): PayPal sandbox funds the paper budget ---
# PayPal SANDBOX app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox). Sandbox only: the client
# refuses any other base URL. Without them, `make paypal-demo` and /paypal run an OFFLINE SIMULATION (labelled).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
