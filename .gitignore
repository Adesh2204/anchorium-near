# Secrets: never commit keys
.env
.env.*
!.env.example
*.key
*.pem
near-credentials/
**/credentials/*.json

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Rust / contract
contracts/**/target/

# Local runtime state (checkpoints, logs)
var/
*.log
*.sqlite
*.sqlite3

# OS / editors
.DS_Store
.idea/
.vscode/

# Media build (submission/media): raw captures, build output and the media venv are never committed
submission/media/raw/
submission/media/.venv/
submission/media/video/*.mp4
Anchorium_Demo_Video*.mp4
